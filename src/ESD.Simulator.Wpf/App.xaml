<Application x:Class="ESD.Simulator.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg"    Color="#0B1120"/>
    <SolidColorBrush x:Key="Panel" Color="#111827"/>
    <SolidColorBrush x:Key="Text"  Color="#E5E7EB"/>
    <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Green" Color="#34D399"/>
    <SolidColorBrush x:Key="Red"   Color="#F87171"/>
    <Style TargetType="Button">
      <Setter Property="Margin"  Value="3"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin"     Value="3"/>
      <Setter Property="Padding"    Value="6"/>
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="Foreground" Value="#E5E7EB"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="3"/>
    </Style>
  </Application.Resources>
</Application>
